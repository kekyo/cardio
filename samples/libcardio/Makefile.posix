CXX ?= g++
CXXOPT ?= -O3 -g
CXXFLAGS ?= -std=c++20 -Wall -Wextra -Wpedantic -pthread
CARDIO_INCLUDE_DIR ?= ../../include
BUILD_DIR ?= ../../build/libcardio

CARDIO_DEFINES ?= -DCARDIO_WITH_LINUX_IO_URING=1
#CARDIO_DEFINES ?= -DCARDIO_WITH_GLIB=1 -DCARDIO_WITH_LINUX_IO_URING=1
#CARDIO_DEFINES ?= -DCARDIO_WITH_GLIB=1 -DCARDIO_WITH_GIO=1
#CARDIO_DEFINES ?= -DCARDIO_HAS_POSIX_FD=0

CARDIO_CXXFLAGS ?=
#CARDIO_CXXFLAGS ?= -fno-exceptions
CARDIO_LDLIBS ?=

SHARED_DEFINES := $(CARDIO_DEFINES) -DCARDIO_SHARED_LIB=1 -DCARDIO_BUILD_SHARED_LIB=1
LIBCARDIO_SO := $(BUILD_DIR)/libcardio.so

.PHONY: all clean

all: $(LIBCARDIO_SO)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(LIBCARDIO_SO): libcardio.cpp $(CARDIO_INCLUDE_DIR)/cardio.h Makefile.posix | $(BUILD_DIR)
	$(CXX) $(CXXOPT) $(CXXFLAGS) -fPIC -I$(CARDIO_INCLUDE_DIR) $(SHARED_DEFINES) $(CARDIO_CXXFLAGS) -shared $< -o $@ $(CARDIO_LDLIBS)

clean:
	rm -rf $(BUILD_DIR)
