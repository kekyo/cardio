WIN32_CXX ?= x86_64-w64-mingw32-g++
CXXOPT ?= -O3 -g
WIN32_CXXFLAGS ?= -std=c++20 -Wall -Wextra -Wpedantic
WIN32_LDFLAGS ?= -static-libgcc -static-libstdc++
WIN32_LDLIBS ?= -luser32
CARDIO_INCLUDE_DIR ?= ../../include
WIN32_BUILD_DIR ?= ../../build/libcardio/win32

CARDIO_DEFINES ?=
#CARDIO_DEFINES ?= -DCARDIO_HAS_WIN32_HANDLE=0

CARDIO_CXXFLAGS ?=
#CARDIO_CXXFLAGS ?= -fno-exceptions
CARDIO_LDLIBS ?=

SHARED_DEFINES := $(CARDIO_DEFINES) -DCARDIO_SHARED_LIB=1 -DCARDIO_BUILD_SHARED_LIB=1
LIBCARDIO_DLL := $(WIN32_BUILD_DIR)/libcardio.dll
LIBCARDIO_IMPLIB := $(WIN32_BUILD_DIR)/libcardio.dll.a

.PHONY: all clean

all: $(LIBCARDIO_DLL) $(LIBCARDIO_IMPLIB)

$(WIN32_BUILD_DIR):
	mkdir -p $(WIN32_BUILD_DIR)

$(LIBCARDIO_DLL) $(LIBCARDIO_IMPLIB): libcardio.cpp $(CARDIO_INCLUDE_DIR)/cardio.h Makefile.win32 | $(WIN32_BUILD_DIR)
	$(WIN32_CXX) $(CXXOPT) $(WIN32_CXXFLAGS) -I$(CARDIO_INCLUDE_DIR) $(SHARED_DEFINES) $(CARDIO_CXXFLAGS) -shared $< -o $(LIBCARDIO_DLL) -Wl,--out-implib,$(LIBCARDIO_IMPLIB) $(WIN32_LDFLAGS) $(WIN32_LDLIBS) $(CARDIO_LDLIBS)

clean:
	rm -rf $(WIN32_BUILD_DIR)
